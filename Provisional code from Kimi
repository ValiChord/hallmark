// ============================================================================
// VALIDATION — DETERMINISTIC ONLY
//
// Rules enforced at publish time. Every peer must reach the same verdict.
// NO DHT lookups (no get, no get_links). Only must_get_valid_record.
// ============================================================================

#[hdk_extern]
pub fn validate(op: Op) -> ExternResult<ValidateCallbackResult> {
    match op.flattened::<UnitEntryTypes, EntryTypes, LinkTypes>()? {
        FlatOp::StoreEntry(store_entry) => match store_entry.entry {
            OpEntry::CreatedEntry(EntryTypes::Attestation(attestation)) => {
                validate_attestation_creation(&attestation, &store_entry.action)
            }
            OpEntry::CreatedEntry(EntryTypes::MembershipProof(proof)) => {
                validate_membership_creation(&proof, &store_entry.action)
            }
            OpEntry::CreatedEntry(EntryTypes::EjectionRecord(record)) => {
                validate_ejection_creation(&record, &store_entry.action)
            }
            OpEntry::CreatedEntry(EntryTypes::KeyRotation(rotation)) => {
                validate_key_rotation(&rotation, &store_entry.action)
            }
            OpEntry::CreatedEntry(EntryTypes::CounterAttestation(counter)) => {
                validate_counter_attestation(&counter, &store_entry.action)
            }
            _ => Ok(ValidateCallbackResult::Valid),
        },
        FlatOp::RegisterUpdate(register_update) => {
            match register_update.entry_type {
                EntryTypes::Attestation(_) | EntryTypes::MembershipProof(_) |
                EntryTypes::EjectionRecord(_) | EntryTypes::CounterAttestation(_) => {
                    Ok(ValidateCallbackResult::Invalid(
                        "Attestations, memberships, ejections and counters are immutable.".to_string()
                    ))
                }
                _ => Ok(ValidateCallbackResult::Valid),
            }
        }
        FlatOp::RegisterDelete(register_delete) => {
            match register_delete.entry_type {
                EntryTypes::Attestation(_) | EntryTypes::MembershipProof(_) |
                EntryTypes::EjectionRecord(_) | EntryTypes::CounterAttestation(_) => {
                    Ok(ValidateCallbackResult::Invalid(
                        "Attestations, memberships, ejections and counters are immutable.".to_string()
                    ))
                }
                _ => Ok(ValidateCallbackResult::Valid),
            }
        }
        _ => Ok(ValidateCallbackResult::Valid),
    }
}

/// Validate an attestation at creation time.
/// DETERMINISTIC: only checks the action and its declared dependencies.
fn validate_attestation_creation(
    attestation: &Attestation,
    action: &EntryCreationAction,
) -> ExternResult<ValidateCallbackResult> {
    let props = dna_props()?;

    // 1. RAF version
    if attestation.raf_version != "0.1" {
        return Ok(ValidateCallbackResult::Invalid(
            "Unsupported RAF version".to_string()
        ));
    }

    // 2. Assertion vocabulary — deterministic check against DNA properties
    for assertion in &attestation.scope.observed {
        if !props.assertion_vocabulary.contains(&assertion.assertion_id) {
            return Ok(ValidateCallbackResult::Invalid(format!(
                "Assertion '{}' not in vocabulary",
                assertion.assertion_id
            )));
        }
    }

    // 3. Author must match attester
    if action.author() != attestation.attester.agent_pubkey {
        return Ok(ValidateCallbackResult::Invalid(
            "Action author does not match attester".to_string()
        ));
    }

    // 4. Membership proof must exist and be structurally valid
    // DETERMINISTIC: must_get_valid_record fetches by hash; all validators see the same record
    let membership_record = must_get_valid_record(attestation.membership_proof_hash.clone())?;
    let membership: MembershipProof = membership_record
        .entry()
        .to_app_option()
        .map_err(|e| wasm_error!(WasmErrorInner::Guest(e.to_string())))?
        .ok_or(wasm_error!(WasmErrorInner::Guest(
            "Referenced membership proof not found".to_string()
        )))?;

    // 5. Membership proof must be for this agent
    if membership.agent_pubkey != attestation.attester.agent_pubkey {
        return Ok(ValidateCallbackResult::Invalid(
            "Membership proof does not match attester".to_string()
        ));
    }

    // 6. Membership must not be expired at action time
    let action_time = action.timestamp();
    if let Some(expires) = membership.expires_at {
        if action_time > expires {
            return Ok(ValidateCallbackResult::Invalid(
                "Membership expired at time of attestation".to_string()
            ));
        }
    }

    // 7. Membership must have been issued before action time
    if action_time < membership.issued_at {
        return Ok(ValidateCallbackResult::Invalid(
            "Membership issued after attestation".to_string()
        ));
    }

    // 8. Predecessor document must exist if claimed
    if let Some(pred_hash) = &attestation.binding.predecessor_document_hash {
        let _pred_record = must_get_valid_record(pred_hash.clone())?;
        // We have the record. Verification-time checks will confirm it is an Attestation
        // for the same serial number. Here we only confirm it exists.
    }

    // NOTE: We do NOT check ejection status here. Ejection is verification-time.
    // A later ejection does not retroactively invalidate this attestation.

    Ok(ValidateCallbackResult::Valid)
}

/// Validate a membership proof.
/// DETERMINISTIC: checks signature against DNA root authorities.
fn validate_membership_creation(
    proof: &MembershipProof,
    action: &EntryCreationAction,
) -> ExternResult<ValidateCallbackResult> {
    let props = dna_props()?;

    // 1. Author must match agent_pubkey
    if action.author() != proof.agent_pubkey {
        return Ok(ValidateCallbackResult::Invalid(
            "Membership proof author mismatch".to_string()
        ));
    }

    // 2. signed_by must be a root authority (deterministic: compare against DNA properties)
    if !props.root_authorities.contains(&proof.signed_by) {
        return Ok(ValidateCallbackResult::Invalid(
            "Membership signer is not a recognized root authority".to_string()
        ));
    }

    // 3. The action author of this membership proof must be the signed_by pubkey
    // (i.e., root authorities issue memberships directly)
    if action.author() != proof.signed_by {
        return Ok(ValidateCallbackResult::Invalid(
            "Membership proof must be authored by the signing root authority".to_string()
        ));
    }

    // 4. Accreditation type must match role
    match (&proof.accreditation.accreditation_type, &proof.role) {
        (AccreditationType::FaaRepairStation, AttesterRole::RepairStation) => Ok(()),
        (AccreditationType::EasaPart145, AttesterRole::RepairStation) => Ok(()),
        (AccreditationType::EasaPart145, AttesterRole::Mro) => Ok(()),
        (AccreditationType::OemAuthorized, AttesterRole::Oem) => Ok(()),
        (AccreditationType::DistributorAccredited, AttesterRole::Distributor) => Ok(()),
        _ => Ok(ValidateCallbackResult::Invalid(
            "Accreditation type does not match role".to_string()
        )),
    }?;

    Ok(ValidateCallbackResult::Valid)
}

/// Validate an ejection record.
/// DETERMINISTIC: checks structural correctness only.
fn validate_ejection_creation(
    record: &EjectionRecord,
    action: &EntryCreationAction,
) -> ExternResult<ValidateCallbackResult> {
    let props = dna_props()?;

    // 1. Ejector must be a root authority (only root authorities can eject)
    if !props.root_authorities.contains(action.author()) {
        return Ok(ValidateCallbackResult::Invalid(
            "Only root authorities can issue ejection records".to_string()
        ));
    }

    // 2. Must have enough validator signatures
    if record.validator_signatures.len() < props.min_ejection_validators as usize {
        return Ok(ValidateCallbackResult::Invalid(format!(
            "Ejection requires at least {} validator signatures, got {}",
            props.min_ejection_validators,
            record.validator_signatures.len()
        )));
    }

    // 3. Grounds must be objective
    match &record.grounds {
        EjectionGrounds::ContradictoryBindings => {
            if record.evidence_hashes.len() < 2 {
                return Ok(ValidateCallbackResult::Invalid(
                    "ContradictoryBindings requires at least 2 evidence attestations".to_string()
                ));
            }
        }
        _ => {
            if record.evidence_hashes.is_empty() {
                return Ok(ValidateCallbackResult::Invalid(
                    "Ejection requires evidence".to_string()
                ));
            }
        }
    }

    Ok(ValidateCallbackResult::Valid)
}

/// Validate a key rotation.
fn validate_key_rotation(
    rotation: &KeyRotation,
    action: &EntryCreationAction,
) -> ExternResult<ValidateCallbackResult> {
    // Author must be the old key or a root authority
    let props = dna_props()?;
    let author = action.author();

    if author != &rotation.old_key && !props.root_authorities.contains(author) {
        return Ok(ValidateCallbackResult::Invalid(
            "Key rotation must be signed by old key or root authority".to_string()
        ));
    }

    Ok(ValidateCallbackResult::Valid)
}

/// Validate a counter-attestation.
fn validate_counter_attestation(
    counter: &CounterAttestation,
    action: &EntryCreationAction,
) -> ExternResult<ValidateCallbackResult> {
    // Author must match attester
    if action.author() != counter.attester.agent_pubkey {
        return Ok(ValidateCallbackResult::Invalid(
            "Counter-attestation author mismatch".to_string()
        ));
    }

    Ok(ValidateCallbackResult::Valid)
}

