// ZOME FUNCTIONS (Callable from UI / external)
// ============================================================================

/// Create an attestation. Runs locally first, then publishes to DHT.
#[hdk_extern]
pub fn create_attestation(attestation: Attestation) -> ExternResult<Record> {
    // Self-check: am I the attester?
    let me = agent_info()?.agent_latest_pubkey;
    if me != attestation.attester.agent_pubkey {
        return Err(wasm_error!(WasmErrorInner::Guest(
            "You can only create attestations as yourself".to_string()
        )));
    }

    let attestation_hash = create_entry(&EntryTypes::Attestation(attestation.clone()))?;

    // Link from part serial number for discoverability
    create_link(
        attestation.subject.serial_number.clone(),
        attestation_hash.clone(),
        LinkTypes::SerialToAttestation,
        (),
    )?;

    // Link from attester for audit trail
    create_link(
        attestation.attester.agent_pubkey.clone(),
        attestation_hash.clone(),
        LinkTypes::AgentToAttestation,
        (),
    )?;

    let record = get(attestation_hash, GetOptions::default())?
        .ok_or(wasm_error!(WasmErrorInner::Guest(
            "Could not get newly created attestation".to_string()
        )))?;

    Ok(record)
}

/// Add a counter-attestation to an existing attestation.
/// A recorded disagreement at the time of delivery is worth more than a resolved one.
#[hdk_extern]
pub fn countersign_attestation(
    input: CountersignInput,
) -> ExternResult<Record> {
    let me = agent_info()?.agent_latest_pubkey;

    // Get the original attestation
    let original = get(input.attestation_hash.clone(), GetOptions::default())?
        .ok_or(wasm_error!(WasmErrorInner::Guest(
            "Attestation not found".to_string()
        )))?;

    let original_attestation: Attestation = original
        .entry()
        .to_app_option()
        .map_err(|e| wasm_error!(WasmErrorInner::Guest(e.to_string())))?
        .ok_or(wasm_error!(WasmErrorInner::Guest(
            "Invalid attestation entry".to_string()
        )))?;

    // Create counter-attestation
    let counter = CounterAttestation {
        attester: input.attester,
        time: sys_time()?,
        agreement: input.agreement,
        discrepancy_notes: input.notes,
    };

    // In Holochain, countersigning uses the built-in countersigning feature
    // where both parties sign the same entry. For simplicity here, we store
    // the counter-attestation as a separate linked entry.
    let counter_hash = create_entry(&EntryTypes::CounterAttestation(counter))?;

    create_link(
        input.attestation_hash.clone(),
        counter_hash.clone(),
        LinkTypes::AttestationToCounter,
        (),
    )?;

    let record = get(counter_hash, GetOptions::default())?
        .ok_or(wasm_error!(WasmErrorInner::Guest(
            "Could not get counter-attestation".to_string()
        )))?;

    Ok(record)
}

/// Issue a membership proof (membrane proof).
/// Restricted to root authorities or existing members with vouch rights.
#[hdk_extern]
pub fn issue_membership(proof: MembershipProof) -> ExternResult<Record> {
    let me = agent_info()?.agent_latest_pubkey;

    // Check if I am authorized to issue memberships
    let my_status = check_historical_membership(&me, sys_time()?)?;
    if my_status != MembershipStatus::Active {
        return Err(wasm_error!(WasmErrorInner::Guest(
            "Not authorized to issue memberships".to_string()
        )));
    }

    let proof_hash = create_entry(&EntryTypes::MembershipProof(proof.clone()))?;

    // Link from agent for historical lookup
    create_link(
        proof.agent_pubkey.clone(),
        proof_hash.clone(),
        LinkTypes::AgentMembership,
        (),
    )?;

    let record = get(proof_hash, GetOptions::default())?
        .ok_or(wasm_error!(WasmErrorInner::Guest(
            "Could not get membership proof".to_string()
        )))?;

    Ok(record)
}

/// Eject a member. Any peer can initiate if they have objective evidence.
#[hdk_extern]
pub fn eject_member(record: EjectionRecord) -> ExternResult<Record> {
    let me = agent_info()?.agent_latest_pubkey;

    // Verify I am a member
    let my_status = check_historical_membership(&me, sys_time()?)?;
    if my_status != MembershipStatus::Active {
        return Err(wasm_error!(WasmErrorInner::Guest(
            "Not authorized to eject members".to_string()
        )));
    }

    let record_hash = create_entry(&EntryTypes::EjectionRecord(record.clone()))?;

    create_link(
        record.agent_pubkey.clone(),
        record_hash.clone(),
        LinkTypes::AgentEjection,
        (),
    )?;

    let rec = get(record_hash, GetOptions::default())?
        .ok_or(wasm_error!(WasmErrorInner::Guest(
            "Could not get ejection record".to_string()
        )))?;

    Ok(rec)
}

/// Verify an attestation as a stranger would.
/// This is the "checkable by a stranger, offline, years later" test.
#[hdk_extern]
pub fn verify_attestation(attestation_hash: ActionHash) -> ExternResult<VerificationReport> {
    let record = get(attestation_hash.clone(), GetOptions::default())?
        .ok_or(wasm_error!(WasmErrorInner::Guest(
            "Attestation not found".to_string()
        )))?;

    let attestation: Attestation = record
        .entry()
        .to_app_option()
        .map_err(|e| wasm_error!(WasmErrorInner::Guest(e.to_string())))?
        .ok_or(wasm_error!(WasmErrorInner::Guest(
            "Invalid entry".to_string()
        )))?;

    let mut report = VerificationReport {
        attestation_hash: attestation_hash.clone(),
        signature_valid: true, // Holochain validates signatures at the framework level
        binding_well_formed: true,
        document_digest_matches: None, // Would need the actual document
        membership_at_assertion: None,
        qualified_timestamp_valid: None,
        scope_report: Vec::new(),
        counter_attestations: Vec::new(),
        overall_valid: true,
    };

    // 1. Check membership at asserted_at
    let membership = check_historical_membership(
        &attestation.attester.agent_pubkey,
        attestation.time,
    )?;

    report.membership_at_assertion = Some(format!("{:?}", membership));
    if membership != MembershipStatus::Active {
        report.overall_valid = false;
    }

    // 2. Check predecessor chain
    if let Some(pred) = &attestation.binding.predecessor_document {
        let pred_exists = check_predecessor_exists(pred)?;
        if !pred_exists {
            report.overall_valid = false;
        }
    }

    // 3. Check assertion vocabulary
    for assertion in &attestation.scope.observed {
        let valid = AVIATION_ASSERTION_VOCABULARY.contains(&assertion.assertion_id.as_str());
        report.scope_report.push(ScopeCheck {
            assertion_id: assertion.assertion_id.clone(),
            valid,
            note: if valid { None } else { Some("Not in vocabulary".to_string()) },
        });
        if !valid {
            report.overall_valid = false;
        }
    }

    // 4. Gather counter-attestations
    let counter_links = get_links(
        GetLinksInputBuilder::try_new(attestation_hash.clone(), LinkTypes::AttestationToCounter)?
            .build(),
    )?;

    for link in counter_links {
        if let Some(target) = link.target.into_action_hash() {
            if let Some(counter_record) = get(target, GetOptions::default())? {
                if let Ok(counter) = counter_record.entry().to_app_option::<CounterAttestation>() {
                    if let Some(counter) = counter {
                        report.counter_attestations.push(counter);
                    }
                }
            }
        }
    }

    Ok(report)
}

