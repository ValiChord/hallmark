// ============================================================================
// Release Attestation Format — Aviation Profile (Back-to-Birth)
// Holochain Zome Implementation
// ============================================================================
//
// This zome implements the aviation-specific attestation logic on Holochain.
// It leverages Holochain's unique properties to solve the trust-list problem
// that has blocked aviation back-to-birth traceability for 16+ years.
//
// KEY HOLCHAIN PROPERTIES USED:
// 1. Agent-centricity: Each repair station/airline/OEM owns their own source chain
// 2. Membrane proofs: Membership is gated by cryptographic accreditation proofs
// 3. Validation-as-code: Ejection rules are deterministic, auditable by anyone
// 4. Countersigning: N=2 transactions need no third party present
// 5. DHT: Strangers verify records years later without contacting issuers
// 6. No global consensus: Local validation rules, no blockchain overhead
//

use hdk::prelude::*;

// ============================================================================
// ENTRY TYPES
// ============================================================================

/// An attestation binds a physical aircraft part to its documentation.
/// This is the core record. It is deliberately NOT a claim that the part
/// is good — only that the binding between artefact and document was
/// observed by the attester at a stated time, within a stated scope.
#[hdk_entry_helper]
#[derive(Clone)]
pub struct Attestation {
    pub raf_version: String,           // "0.1"
    pub subject: Subject,              // The physical part
    pub binding: Binding,              // Link: part serial → document
    pub scope: Scope,                  // What was / was-not observed
    pub evidence: Vec<Evidence>,       // Digests, not documents
    pub attester: Attester,            // Who signed, in what role
    pub time: Timestamp,               // When asserted
    pub anchor: Option<Anchor>,        // Qualified timestamp (optional)
}

#[derive(Serialize, Deserialize, Debug, Clone)]
pub struct Subject {
    pub part_type: PartType,           // Engine, LRU, consumable, etc.
    pub part_number: String,           // Manufacturer part number
    pub serial_number: String,         // The unique physical identifier
    pub description: String,
}

#[derive(Serialize, Deserialize, Debug, Clone)]
pub enum PartType {
    Engine,
    Propeller,
    LifeLimited,
    Serialized,
    Standard,                          // Non-serialized — the hard case for #9
}

#[derive(Serialize, Deserialize, Debug, Clone)]
pub struct Binding {
    pub binds_field: String,           // e.g., "serial_number"
    pub document_type: DocumentType,   // 8130-3, EASA Form 1, etc.
    pub document_id: String,           // Form tracking number
    pub document_digest: String,       // sha256:...
    pub predecessor_document: Option<String>, // Ch 16 chain link
}

#[derive(Serialize, Deserialize, Debug, Clone)]
pub enum DocumentType {
    Faa81303,
    EasaForm1,
    CasaForm1,
    TccaFormOne,
    CertificateOfConformance,
    TransferDocument,
}

/// SCOPE IS THE LOAD-BEARING FIELD.
/// Every assertion is discrete. Absence is never assent.
#[derive(Serialize, Deserialize, Debug, Clone)]
pub struct Scope {
    pub observed: Vec<Assertion>,
    pub not_observed: Vec<String>,     // Assertion IDs explicitly not witnessed
}

#[derive(Serialize, Deserialize, Debug, Clone)]
pub struct Assertion {
    pub assertion_id: String,          // From closed vocabulary
    pub value: AssertionValue,
}

#[derive(Serialize, Deserialize, Debug, Clone)]
pub enum AssertionValue {
    Bool(bool),
    String(String),
    NotApplicable,
}

/// Closed vocabulary for aviation attestations.
/// Free text is not an assertion.
pub const AVIATION_ASSERTION_VOCABULARY: &[&str] = &[
    "part.received_from_known_supplier",
    "part.packaging_intact",
    "part.serial_number_verified_physically",
    "part.serial_number_matches_document",
    "document.8130_3_present",
    "document.easa_form_1_present",
    "document.signature_present",
    "document.predecessor_chain_verified",
    "document.issue_date_within_shelf_life",
    "traceability.back_to_birth_complete",
    "traceability.oem_traceable",
    "traceability.repair_station_traceable",
    "condition.new",
    "condition.overhauled",
    "condition.inspected",
    "condition.repaired",
    "regulatory.faa_8130_3_compliant",
    "regulatory.easa_form_1_compliant",
    "regulatory.export_8130_3_tag_attached",
    "custody.sealed_packaging_broken_by_me",
    "custody.seal_number_recorded",
];

#[derive(Serialize, Deserialize, Debug, Clone)]
pub struct Evidence {
    pub evidence_type: String,
    pub digest: String,                // sha256:...
    pub locator: Option<String>,       // Opaque or absent
}

#[derive(Serialize, Deserialize, Debug, Clone)]
pub struct Attester {
    pub agent_pubkey: AgentPubKey,     // Holochain agent ID
    pub role: AttesterRole,
    pub organisation: String,
    pub organisation_id: String,       // FAA repair station cert #, EASA Part 145 #, etc.
}

#[derive(Serialize, Deserialize, Debug, Clone)]
pub enum AttesterRole {
    RepairStation,
    Airline,
    Oem,
    Mro,
    Distributor,
    Broker,
    Lessors,
}

#[derive(Serialize, Deserialize, Debug, Clone)]
pub struct Anchor {
    pub qualified_timestamp: String,   // rfc3161:...
    pub timestamp_service_id: String,
}

/// A counter-attestation from the other party.
/// Agreement AND disagreement are both useful.
#[derive(Serialize, Deserialize, Debug, Clone)]
pub struct CounterAttestation {
    pub attester: Attester,
    pub time: Timestamp,
    pub agreement: AgreementStatus,
    pub discrepancy_notes: Option<String>,
}

#[derive(Serialize, Deserialize, Debug, Clone)]
pub enum AgreementStatus {
    Agree,
    Disagree,
    Partial,
}

// ============================================================================
// MEMBERSHIP & EJECTION
// ============================================================================

/// Membrane proof: the cryptographic gate that lets an agent join the DHT.
/// In aviation, this replaces the "trust list" — instead of a central registry,
/// membership is proven by existing accreditation infrastructure.
#[hdk_entry_helper]
#[derive(Clone)]
pub struct MembershipProof {
    pub agent_pubkey: AgentPubKey,
    pub role: AttesterRole,
    pub accreditation: Accreditation,
    pub issued_at: Timestamp,
    pub expires_at: Option<Timestamp>,
    pub signed_by: AgentPubKey,        // Accrediting body OR vouching member
    pub vouch_chain: Vec<AgentPubKey>, // Chain of vouches back to a root authority
}

#[derive(Serialize, Deserialize, Debug, Clone)]
pub struct Accreditation {
    pub accreditation_type: AccreditationType,
    pub cert_number: String,           // FAA RS #: XXXXR, EASA Part 145: etc.
    pub issuing_authority: String,     // "FAA", "EASA", "CASA", etc.
    pub document_digest: String,       // Digest of the actual cert
}

#[derive(Serialize, Deserialize, Debug, Clone)]
pub enum AccreditationType {
    FaaRepairStation,
    EasaPart145,
    EasaPart21g,
    FaaPma,
    OemAuthorized,
    DistributorAccredited,            // e.g., ASA-100, ISO 9001+AS9120
}

/// Root authorities are hard-coded in the DNA.
/// They are the "genesis" trust anchors — existing regulators/standards bodies.
/// This avoids the infinite regress of "who watches the watchers."
pub const ROOT_AUTHORITIES: &[&str] = &[
    "FAA",
    "EASA",
    "CASA",
    "TCCA",
    "CAAC",
];

/// EjectionRecord: the mechanism for removing bad actors.
/// Grounds MUST be objective, published in advance, and verifiable by anyone.
#[hdk_entry_helper]
#[derive(Clone)]
pub struct EjectionRecord {
    pub agent_pubkey: AgentPubKey,
    pub grounds: EjectionGrounds,
    pub evidence_hashes: Vec<ActionHash>, // Links to contradictory attestations
    pub decided_at: Timestamp,
    pub validation_threshold_met: bool,   // Enough peer validators confirmed
}

#[derive(Serialize, Deserialize, Debug, Clone)]
pub enum EjectionGrounds {
    /// Attester issued attestations whose bindings contradict each other
    /// (e.g., same serial number bound to two different documents)
    ContradictoryBindings,
    /// Attester signed an attestation outside their accredited scope
    EntitlementViolation,
    /// Attestation contained an assertion ID not in the closed vocabulary
    InvalidAssertionVocabulary,
    /// Membership proof was forged or expired
    InvalidMembership,
    /// Key rotation without proper accreditation confirmation
    UnauthorizedKeyRotation,
}

