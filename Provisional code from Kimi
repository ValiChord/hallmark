/// Long-lived records need key rotation. MARPOL wants 3 years;
/// aviation parts fly for decades. Key material outlives no design.
#[hdk_entry_helper]
#[derive(Clone)]
pub struct KeyRotation {
    pub agent_pubkey: AgentPubKey,
    pub old_key: AgentPubKey,
    pub new_key: AgentPubKey,
    pub accreditation_confirming: Accreditation,
    pub rotated_at: Timestamp,
    pub continuity_proof: String,      // Old key signs new key, OR accreditor signs
}

// ============================================================================
// VALIDATION RULES — THE LOAD-BEARING CODE
// ============================================================================
//
// These rules are the "operator". They run on every peer's machine.
// A stranger can audit them by reading the DNA.
// This satisfies SPEC.md §6: "Membership rules MUST be expressed as code
// that any participant can run and any stranger can audit."

#[hdk_extern]
pub fn validate(op: Op) -> ExternResult<ValidateCallbackResult> {
    match op.flattened::<(), EntryTypes, LinkTypes>()? {
        FlatOp::StoreEntry(store_entry) => match store_entry.entry {
            OpEntry::CreatedEntry(EntryTypes::Attestation(attestation)) => {
                validate_attestation_creation(&attestation, &store_entry.action)
            }
            OpEntry::CreatedEntry(EntryTypes::MembershipProof(proof)) => {
                validate_membership_creation(&proof, &store_entry.action)
            }
            OpEntry::CreatedEntry(EntryTypes::EjectionRecord(record)) => {
                validate_ejection_creation(&record, &store_entry.action)
            }
            OpEntry::CreatedEntry(EntryTypes::KeyRotation(rotation)) => {
                validate_key_rotation(&rotation, &store_entry.action)
            }
            _ => Ok(ValidateCallbackResult::Valid),
        },
        FlatOp::RegisterUpdate(register_update) => {
            // Attestations are immutable. Updates are rejected.
            match register_update.entry_type {
                EntryTypes::Attestation(_) => Ok(ValidateCallbackResult::Invalid(
                    "Attestations are immutable. Issue a new attestation with predecessor link.".to_string()
                )),
                _ => Ok(ValidateCallbackResult::Valid),
            }
        }
        FlatOp::RegisterDelete(register_delete) => {
            // Attestations are immutable. Deletes are rejected.
            match register_delete.entry_type {
                EntryTypes::Attestation(_) => Ok(ValidateCallbackResult::Invalid(
                    "Attestations are immutable. Issue a counter-attestation instead.".to_string()
                )),
                _ => Ok(ValidateCallbackResult::Valid),
            }
        }
        _ => Ok(ValidateCallbackResult::Valid),
    }
}

/// Validate an attestation at creation time.
fn validate_attestation_creation(
    attestation: &Attestation,
    action: &EntryCreationAction,
) -> ExternResult<ValidateCallbackResult> {
    // 1. Check RAF version
    if attestation.raf_version != "0.1" {
        return Ok(ValidateCallbackResult::Invalid(
            "Unsupported RAF version".to_string()
        ));
    }

    // 2. Check that all assertions are from the closed vocabulary
    for assertion in &attestation.scope.observed {
        if !AVIATION_ASSERTION_VOCABULARY.contains(&assertion.assertion_id.as_str()) {
            return Ok(ValidateCallbackResult::Invalid(format!(
                "Assertion '{}' not in closed vocabulary",
                assertion.assertion_id
            )));
        }
    }

    // 3. Check that the attester was a member at the time of assertion
    // This is the HARD PART (SPEC.md §7 step 4).
    // We query the DHT for membership proofs and ejection records.
    let membership_status = check_historical_membership(
        &attestation.attester.agent_pubkey,
        attestation.time,
    )?;

    match membership_status {
        MembershipStatus::Active => {}
        MembershipStatus::NotMember => {
            return Ok(ValidateCallbackResult::Invalid(
                "Attester was not a member at asserted_at".to_string()
            ));
        }
        MembershipStatus::Ejected(ejected_at) => {
            if attestation.time > ejected_at {
                return Ok(ValidateCallbackResult::Invalid(
                    "Attester was ejected before asserted_at".to_string()
                ));
            }
        }
        MembershipStatus::Expired(expired_at) => {
            if attestation.time > expired_at {
                return Ok(ValidateCallbackResult::Invalid(
                    "Attester's membership had expired at asserted_at".to_string()
                ));
            }
        }
    }

    // 4. Check that the signer (action author) matches the attester
    let author = action.author().clone();
    if author != attestation.attester.agent_pubkey {
        return Ok(ValidateCallbackResult::Invalid(
            "Action author does not match attester agent_pubkey".to_string()
        ));
    }

    // 5. Check that predecessor document exists if claimed
    if let Some(pred_id) = &attestation.binding.predecessor_document {
        let pred_exists = check_predecessor_exists(pred_id)?;
        if !pred_exists {
            return Ok(ValidateCallbackResult::Invalid(
                "Predecessor document not found in DHT".to_string()
            ));
        }
    }

    Ok(ValidateCallbackResult::Valid)
}

/// Validate a membership proof.
fn validate_membership_creation(
    proof: &MembershipProof,
    action: &EntryCreationAction,
) -> ExternResult<ValidateCallbackResult> {
    // 1. Author must match the agent_pubkey in the proof
    if action.author() != proof.agent_pubkey {
        return Ok(ValidateCallbackResult::Invalid(
            "Membership proof author mismatch".to_string()
        ));
    }

    // 2. Check that the signer (signed_by) is authorized to issue this accreditation
    let signer_is_root = ROOT_AUTHORITIES.contains(&proof.accreditation.issuing_authority.as_str());
    let signer_is_member = check_historical_membership(&proof.signed_by, proof.issued_at)?
        == MembershipStatus::Active;

    if !signer_is_root && !signer_is_member {
        return Ok(ValidateCallbackResult::Invalid(
            "Membership signer is not a recognized authority".to_string()
        ));
    }

    // 3. Check that the accreditation type matches the role
    match (&proof.accreditation.accreditation_type, &proof.role) {
        (AccreditationType::FaaRepairStation, AttesterRole::RepairStation) => Ok(()),
        (AccreditationType::EasaPart145, AttesterRole::RepairStation) => Ok(()),
        (AccreditationType::EasaPart145, AttesterRole::Mro) => Ok(()),
        (AccreditationType::OemAuthorized, AttesterRole::Oem) => Ok(()),
        (AccreditationType::DistributorAccredited, AttesterRole::Distributor) => Ok(()),
        _ => Err(wasm_error!(WasmErrorInner::Guest(
            "Accreditation type does not match role".to_string()
        ))),
    }?;

    Ok(ValidateCallbackResult::Valid)
}

/// Validate an ejection record.
fn validate_ejection_creation(
    record: &EjectionRecord,
    action: &EntryCreationAction,
) -> ExternResult<ValidateCallbackResult> {
    // 1. Grounds must be objective and verifiable
    match &record.grounds {
        EjectionGrounds::ContradictoryBindings => {
            // Must provide evidence: at least 2 attestations with contradictory bindings
            if record.evidence_hashes.len() < 2 {
                return Ok(ValidateCallbackResult::Invalid(
                    "ContradictoryBindings requires at least 2 evidence attestations".to_string()
                ));
            }
            // Verify the contradictions
            let contradiction_verified = verify_binding_contradiction(&record.evidence_hashes)?;
            if !contradiction_verified {
                return Ok(ValidateCallbackResult::Invalid(
                    "Evidence does not show contradictory bindings".to_string()
                ));
            }
        }
        EjectionGrounds::EntitlementViolation => {
            // Evidence must show an attestation outside accredited scope
            if record.evidence_hashes.is_empty() {
                return Ok(ValidateCallbackResult::Invalid(
                    "EntitlementViolation requires evidence".to_string()
                ));
            }
        }
        EjectionGrounds::InvalidAssertionVocabulary => {
            // Evidence must show an attestation with invalid assertion ID
            if record.evidence_hashes.is_empty() {
                return Ok(ValidateCallbackResult::Invalid(
                    "InvalidAssertionVocabulary requires evidence".to_string()
                ));
            }
        }
        EjectionGrounds::InvalidMembership => {
            // Evidence must show a forged or expired membership proof
            if record.evidence_hashes.is_empty() {
                return Ok(ValidateCallbackResult::Invalid(
                    "InvalidMembership requires evidence".to_string()
                ));
            }
        }
        EjectionGrounds::UnauthorizedKeyRotation => {
            if record.evidence_hashes.is_empty() {
                return Ok(ValidateCallbackResult::Invalid(
                    "UnauthorizedKeyRotation requires evidence".to_string()
                ));
            }
        }
    }

    // 2. The ejector must be a member
    let ejector_status = check_historical_membership(action.author(), record.decided_at)?;
    if ejector_status != MembershipStatus::Active {
        return Ok(ValidateCallbackResult::Invalid(
            "Ejector was not an active member at decision time".to_string()
        ));
    }

    // 3. validation_threshold_met: in a real implementation, this would require
    // N peer validators to independently confirm. For now, we check that at least
    // one other peer has countersigned.
    if !record.validation_threshold_met {
        return Ok(ValidateCallbackResult::Invalid(
            "Ejection requires peer validation threshold".to_string()
        ));
    }

    Ok(ValidateCallbackResult::Valid)
}

/// Validate a key rotation.
fn validate_key_rotation(
    rotation: &KeyRotation,
    action: &EntryCreationAction,
) -> ExternResult<ValidateCallbackResult> {
    // 1. Author must be the old key or the accrediting body
    let author = action.author();
    if author != &rotation.old_key {
        // Must be signed by accrediting body
        let accredit_status = check_historical_membership(author, rotation.rotated_at)?;
        if accredit_status != MembershipStatus::Active {
            return Ok(ValidateCallbackResult::Invalid(
                "Key rotation must be signed by old key or active accreditor".to_string()
            ));
        }
    }

    // 2. Accreditation confirming must be valid
    // (In production, verify the accreditation document exists and is current)

    Ok(ValidateCallbackResult::Valid)
}

// ============================================================================
// MEMBERSHIP CHECK — THE HARD PART
// ============================================================================

#[derive(Debug, PartialEq)]
pub enum MembershipStatus {
    Active,
    NotMember,
    Ejected(Timestamp),
    Expired(Timestamp),
}

/// Check if an agent was a member at a specific historical time.
/// This is SPEC.md §7 step 4 — "Membership is historical; this is the hard part."
///
/// In Holochain, we query the DHT for all MembershipProof and EjectionRecord
/// entries for this agent, then reconstruct the timeline.
fn check_historical_membership(
    agent: &AgentPubKey,
    at_time: Timestamp,
) -> ExternResult<MembershipStatus> {
    // Query DHT for all MembershipProof entries linked to this agent
    let membership_links = get_links(
        GetLinksInputBuilder::try_new(agent.clone(), LinkTypes::AgentMembership)?
            .build(),
    )?;

    let mut memberships: Vec<(Timestamp, ActionHash)> = Vec::new();
    for link in membership_links {
        if let Some(target) = link.target.into_entry_hash() {
            if let Some(record) = get(target, GetOptions::default())? {
                if let Ok(proof) = record.entry().to_app_option::<MembershipProof>() {
                    if let Some(proof) = proof {
                        memberships.push((proof.issued_at, record.action_address().clone()));
                    }
                }
            }
        }
    }

    // Sort by time
    memberships.sort_by_key(|(t, _)| *t);

    // Find the most recent membership proof that was active at `at_time`
    let mut active_membership: Option<&(Timestamp, ActionHash)> = None;
    for (issued, hash) in &memberships {
        if *issued <= at_time {
            active_membership = Some((*issued, hash));
        } else {
            break;
        }
    }

    if active_membership.is_none() {
        return Ok(MembershipStatus::NotMember);
    }

    // Check for ejection before at_time
    let ejection_links = get_links(
        GetLinksInputBuilder::try_new(agent.clone(), LinkTypes::AgentEjection)?
            .build(),
    )?;

    let mut ejections: Vec<Timestamp> = Vec::new();
    for link in ejection_links {
        if let Some(target) = link.target.into_entry_hash() {
            if let Some(record) = get(target, GetOptions::default())? {
                if let Ok(ejection) = record.entry().to_app_option::<EjectionRecord>() {
                    if let Some(ejection) = ejection {
                        ejections.push(ejection.decided_at);
                    }
                }
            }
        }
    }

    ejections.sort();

    // Check if ejected before at_time
    for ejected_at in &ejections {
        if *ejected_at <= at_time {
            return Ok(MembershipStatus::Ejected(*ejected_at));
        }
    }

    // Check expiry
    if let Some((_, hash)) = active_membership {
        if let Some(record) = get(hash.clone(), GetOptions::default())? {
            if let Ok(proof) = record.entry().to_app_option::<MembershipProof>() {
                if let Some(proof) = proof {
                    if let Some(expires) = proof.expires_at {
                        if at_time > expires {
                            return Ok(MembershipStatus::Expired(expires));
                        }
                    }
                }
            }
        }
    }

    Ok(MembershipStatus::Active)
}

