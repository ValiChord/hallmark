fn verify_binding_contradiction(evidence: &[ActionHash]) -> ExternResult<bool> {
    // Fetch both attestations and check if they bind the same serial to different docs
    if evidence.len() < 2 {
        return Ok(false);
    }

    let first = get(evidence[0].clone(), GetOptions::default())?;
    let second = get(evidence[1].clone(), GetOptions::default())?;

    match (first, second) {
        (Some(r1), Some(r2)) => {
            let a1: Attestation = r1.entry().to_app_option()
                .map_err(|e| wasm_error!(WasmErrorInner::Guest(e.to_string())))?
                .ok_or(wasm_error!(WasmErrorInner::Guest("Invalid".to_string())))?;
            let a2: Attestation = r2.entry().to_app_option()
                .map_err(|e| wasm_error!(WasmErrorInner::Guest(e.to_string())))?
                .ok_or(wasm_error!(WasmErrorInner::Guest("Invalid".to_string())))?;

            // Same serial, different document
            let same_serial = a1.subject.serial_number == a2.subject.serial_number;
            let different_doc = a1.binding.document_id != a2.binding.document_id;

            Ok(same_serial && different_doc)
        }
        _ => Ok(false),
    }
}

