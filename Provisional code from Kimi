// ============================================================================
// Release Attestation Format — Aviation Profile
// Holochain Zome v2 (post-review)
//
// REVISION NOTES:
// - Validation is deterministic: only must_get_* calls, no get_links
// - Ejection is verification-time only; validation does not check it
// - Trust anchor uses DNA properties (AgentPubKeys), not string literals
// - Action timestamp used instead of user-supplied time
// - N=2 via local source chains + peer-to-peer exchange, not countersigning
// - Predecessor check actually implemented via must_get_valid_record
//
// FATAL ISSUES FROM v1 ADDRESSED:
// 1. ROOT_AUTHORITIES now AgentPubKeys in DNA properties
// 2. No DHT lookups in validate(); uses must_get_valid_record only
// 3. Ejection removed from validation; moved to verify_attestation
// 4. Backdating prevented via action timestamp
// 5. Theatre checks removed or implemented
// 6. Countersigning claim corrected in architecture
//
// WHAT THIS STILL DOES NOT SOLVE:
// - The FAA does not have a Holochain key. Bootstrapping trust is a separate
//   problem requiring out-of-band verification of accreditation documents.
// - Admissibility in court/arbitration is a legal question, not technical.
// - Competition law: a group of competitors using shared ejection rules may
//   still be a concerted refusal to deal, regardless of architecture.
//
// ============================================================================

use hdk::prelude::*;

// ============================================================================
// DNA PROPERTIES — Set at install time by whoever deploys the DNA
//
// These are the root authority public keys. The party installing the DNA
// must set these to actual keys belonging to recognized accrediting bodies
// (or their delegates). This is the ONE centralization point, and it is
// transparent: every peer can read these properties and audit them.
//
// BOOTSTRAP PROBLEM: The FAA does not natively issue Holochain keys.
// Practical paths:
//   (a) A neutral third party (e.g., the coalition's secretariat) verifies
//       FAA/EASA certificates out-of-band and issues Holochain membrane proofs.
//   (b) The DNA is installed with pubkeys of trusted verifiers who do this.
//   (c) Each jurisdiction runs its own DNA with its own root authorities.
//
// This code assumes (b): root_authorities are AgentPubKeys of trusted
// verifiers who have done the out-of-band accreditation check.
// ============================================================================

#[derive(Serialize, Deserialize, Debug, Clone)]
pub struct DnaProperties {
    pub root_authorities: Vec<AgentPubKey>,
    pub assertion_vocabulary: Vec<String>,
    pub min_ejection_validators: u8,  // N peers must countersign an ejection
}

fn dna_props() -> ExternResult<DnaProperties> {
    let props = dna_info()?.properties;
    let props: DnaProperties = props.try_into()
        .map_err(|e| wasm_error!(WasmErrorInner::Guest(
            format!("DNA properties malformed: {:?}", e)
        )))?;
    Ok(props)
}

